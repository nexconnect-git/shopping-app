[Unit]
Description=Renew Nextou HTTPS certificates
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt -v /var/www/acme:/var/www/acme certbot/certbot:v5.8.0@sha256:f70ad0adbb7e117f0fe42a63c553f28ea451edabc0148757b6efcd9735acaa20 renew --webroot -w /var/www/acme --quiet
ExecStartPost=/usr/bin/docker compose --project-directory /opt/nextou -f /opt/nextou/compose.json exec -T frontend nginx -s reload
