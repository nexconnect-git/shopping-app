{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadRelease",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::nextou-deployment-622308589716-ap-south-1/github-releases/*"
    },
    {
      "Sid": "DeployOnlyNextou",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-south-1:622308589716:document/Nextou-DeployRelease",
        "arn:aws:ec2:ap-south-1:622308589716:instance/i-0e5681a5cb534dde7"
      ]
    },
    {
      "Sid": "ReadDeploymentResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
